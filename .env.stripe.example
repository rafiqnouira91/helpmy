# Copy these entries into .env.local for development (git-ignored).
# Keep the existing Supabase URL / publishable-key settings.
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Raw runtime secrets belong in your deployment host's secret settings.
# Never add VITE_ prefixes to these three secret variables.
