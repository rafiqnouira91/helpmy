# Browser-safe Supabase configuration (same project as the server).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix secrets with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Must match the origin used in your browser; no trailing path.
APP_URL=http://localhost:3000
# Only sk_test_ keys are accepted. Never use a live key.
STRIPE_SECRET_KEY=
# From Stripe CLI locally, or the webhook destination in the sandbox when hosted.
STRIPE_WEBHOOK_SECRET=
